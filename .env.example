DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=homebot
DB_USER=homebot
DB_PASSWORD=replace-with-a-strong-database-password
DB_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Use the broker's reachable IP or DNS name. For Docker Desktop on this Mac,
# host.docker.internal reaches a broker running on the host computer.
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
MQTT_USERNAME=esp32
MQTT_PASSWORD=replace-with-the-broker-password
