DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=homebot
DB_USER=homebot
DB_PASSWORD=replace-with-a-strong-database-password
DB_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# The Django and MQTT-worker containers connect to the Mosquitto service by this name.
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=esp32
MQTT_PASSWORD=replace-with-the-same-password-used-to-create-mosquitto-passwordfile
MQTT_BIND_ADDRESS=0.0.0.0

# Optional. Set these to enable signed alerts sent to Hermes.
HOMEBOT_HERMES_WEBHOOK_URL=
HOMEBOT_HERMES_WEBHOOK_SECRET=
